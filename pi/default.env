# /etc/default/balloon  --  environment for the balloon services (edit on the Pi, then
# sudo systemctl restart 'balloon-*').  See pi/balloon/config.py for every option.
BALLOON_DATA=/data/balloon
BALLOON_SAMPLE_HZ=5
BALLOON_CAMERA_RES=640x480
BALLOON_CAMERA_FPS=15
# analog Grove sensors: name:channel  (A0 light, A2 UV, A4 air quality). Remove what is not plugged in.
BALLOON_ANALOG=light:0,uv:2,aq:4
# set to 1 and plug an SG90 into D18 to enable camera pan from the dashboard
BALLOON_SERVO=0
