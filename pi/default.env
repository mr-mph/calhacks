# /etc/default/balloon  --  environment for the balloon services (edit on the Pi, then
# sudo systemctl restart 'balloon-*').  See pi/balloon/config.py for every option.
BALLOON_DATA=/data/balloon
BALLOON_SAMPLE_HZ=5
BALLOON_CAMERA_RES=1280x720
BALLOON_CAMERA_FPS=15
# analog Grove sensors: name:channel. We have the Air Quality v1.3 on A4. Add light:0 or uv:2 only if those sensors are plugged in.
BALLOON_ANALOG=aq:4
# set to 1 and plug an SG90 into D18 to enable camera pan from the dashboard
BALLOON_SERVO=0

# the barometer reads the Pi's own heat; subtract it
BALLOON_TEMP_OFFSET_C=-24
